#!/bin/bash

# Cross-platform launcher for CIMS virtual environment and Jupyter Lab
# Works on Mac, Linux, and Windows (Git Bash/WSL)
# Usage: ./launch_cims [venv-name] [--no-jupyter] [--no-update]

set -e

# Configuration
VENV_NAME="${1:-cims-env}"
LAUNCH_JUPYTER=true
UPDATE_DEPS=true
MIN_PYTHON_VERSION=(3 9)

# Detect OS
detect_os() {
    case "$(uname -s)" in
        Darwin*)    echo "mac" ;;
        Linux*)     echo "linux" ;;
        CYGWIN*)    echo "windows" ;;
        MINGW*)     echo "windows" ;;
        MSYS*)      echo "windows" ;;
        *)          echo "unknown" ;;
    esac
}

OS=$(detect_os)

# Parse optional flags
for arg in "$@"; do
    case $arg in
        --no-jupyter) LAUNCH_JUPYTER=false ;;
        --no-update) UPDATE_DEPS=false ;;
        --help)
            echo "Usage: $0 [venv-name] [--no-jupyter] [--no-update]"
            echo "  venv-name      Name of virtual environment (default: cims-env)"
            echo "  --no-jupyter   Skip launching Jupyter Lab"
            echo "  --no-update    Skip updating dependencies"
            exit 0
            ;;
    esac
done

# Colors (disable on Windows if not supported)
if [ "$OS" = "windows" ]; then
    RED=''
    GREEN=''
    BLUE=''
    YELLOW=''
    NC=''
else
    RED='\033[0;31m'
    GREEN='\033[0;92m'
    BLUE='\033[0;36m'
    YELLOW='\033[0;33m'
    NC='\033[0m'
fi

msg() { echo -e "${BLUE}$1${NC}"; }
success() { echo -e "${GREEN}$1${NC}"; }
error() { echo -e "${RED}$1${NC}"; exit 1; }
warning() { echo -e "${YELLOW}$1${NC}"; }

# Check Python version
check_python_version() {
    local python_path=$1
    "$python_path" -c "import sys; assert sys.version_info >= (${MIN_PYTHON_VERSION[0]}, ${MIN_PYTHON_VERSION[1]})" 2>/dev/null
}

# Find all Python 3.9+ installations
find_python_versions() {
    local python_versions=()
    
    # Common Python command names to check
    local python_names=("python3" "python")
    
    # On Windows, also check py launcher and common install locations
    if [ "$OS" = "windows" ]; then
        python_names+=("py")
        
        # Check common Windows Python locations
        local win_paths=(
            "/c/Python3"*
            "/c/Program Files/Python3"*
            "/c/Users/$USER/AppData/Local/Programs/Python/Python3"*
        )
        
        for win_path in "${win_paths[@]}"; do
            if [ -d "$win_path" ]; then
                local py_exe="$win_path/python.exe"
                if [ -x "$py_exe" ] && check_python_version "$py_exe"; then
                    python_versions+=("$py_exe")
                fi
            fi
        done
    fi
    
    # Search PATH for python executables
    IFS=':' read -r -a path_dirs <<< "$PATH"
    for dir in "${path_dirs[@]}"; do
        if [ -d "$dir" ]; then
            # Check python3.x executables (Unix-style)
            for python_exe in "$dir"/python3.*; do
                if [ -x "$python_exe" ] && [ ! -d "$python_exe" ] && check_python_version "$python_exe"; then
                    python_versions+=("$python_exe")
                fi
            done
            
            # Check general python/python3 commands
            for name in "${python_names[@]}"; do
                local python_exe="$dir/$name"
                # On Windows, check for .exe extension
                if [ "$OS" = "windows" ] && [ ! -f "$python_exe" ]; then
                    python_exe="$dir/$name.exe"
                fi
                
                if [ -x "$python_exe" ] && check_python_version "$python_exe"; then
                    python_versions+=("$python_exe")
                fi
            done
        fi
    done
    
    # Remove duplicates and sort by version (newest first)
    printf '%s\n' "${python_versions[@]}" | sort -u | sort -rV
}

# Create virtual environment with selected Python version
create_virtual_env() {
    local python_options=()
    readarray -t python_options < <(find_python_versions)
    
    if [ ${#python_options[@]} -eq 0 ]; then
        error "No Python >= ${MIN_PYTHON_VERSION[0]}.${MIN_PYTHON_VERSION[1]} found. Please install Python and try again."
    fi
    
    # Show selection menu
    warning "Select Python version for virtual environment:"
    local menu_options=()
    for py_path in "${python_options[@]}"; do
        local version=$("$py_path" --version 2>&1 | awk '{print $2}')
        if [ "$py_path" = "${python_options[0]}" ]; then
            menu_options+=("$py_path (v${version}) - RECOMMENDED")
        else
            menu_options+=("$py_path (v${version})")
        fi
    done
    menu_options+=("Cancel - I'll install another version")
    
    PS3="Enter selection number: "
    select choice in "${menu_options[@]}"; do
        if [ -n "$choice" ]; then
            if [[ "$choice" == "Cancel"* ]]; then
                error "Installation cancelled. Please install Python >= ${MIN_PYTHON_VERSION[0]}.${MIN_PYTHON_VERSION[1]} and try again."
            fi
            
            # Extract Python path from selection
            SELECTED_PYTHON=$(echo "$choice" | sed 's/ - RECOMMENDED//' | awk '{print $1}')
            local selected_version=$("$SELECTED_PYTHON" --version 2>&1 | awk '{print $2}')
            success "Selected Python ${selected_version}"
            break
        fi
    done
    
    # Create virtual environment
    msg "Creating virtual environment: ${VENV_NAME}"
    "$SELECTED_PYTHON" -m venv "${VENV_NAME}"
    success "Virtual environment created"
}

# Get activation script path (different on Windows vs Unix)
get_activate_script() {
    if [ "$OS" = "windows" ]; then
        echo "${VENV_NAME}/Scripts/activate"
    else
        echo "${VENV_NAME}/bin/activate"
    fi
}

# Get Python executable path (different on Windows vs Unix)
get_venv_python() {
    if [ "$OS" = "windows" ]; then
        echo "${VENV_NAME}/Scripts/python.exe"
    else
        echo "${VENV_NAME}/bin/python"
    fi
}

# Create virtual environment if it doesn't exist
if [ ! -d "${VENV_NAME}" ]; then
    create_virtual_env
    INSTALL_DEPS=true
else
    msg "Virtual environment found: ${VENV_NAME}"
    INSTALL_DEPS=$UPDATE_DEPS
fi

# Activate virtual environment
ACTIVATE_SCRIPT=$(get_activate_script)
if [ ! -f "$ACTIVATE_SCRIPT" ]; then
    error "Virtual environment activation script not found: $ACTIVATE_SCRIPT"
fi

msg "Activating virtual environment..."
source "$ACTIVATE_SCRIPT"
success "Activated"

# Verify activation by checking python path
VENV_PYTHON=$(get_venv_python)
if [ ! -f "$VENV_PYTHON" ]; then
    warning "Warning: Expected Python not found at $VENV_PYTHON"
fi

# Install/update dependencies
if [ "$INSTALL_DEPS" = true ]; then
    if [ ! -f "requirements.txt" ]; then
        warning "requirements.txt not found, skipping dependency installation"
    else
        msg "Installing dependencies..."
        pip install -q --upgrade pip
        pip install -q -r requirements.txt
        success "Dependencies installed"
    fi
fi

# Launch Jupyter Lab
if [ "$LAUNCH_JUPYTER" = true ]; then
    # Check if Jupyter is installed
    if ! command -v jupyter &> /dev/null; then
        error "Jupyter not found. Please add 'jupyterlab' to requirements.txt"
    fi
    
    # Check if notebook exists
    if [ -f "./scenarios/Reference.ipynb" ]; then
        msg "Launching Jupyter Lab... (Press Ctrl+C to exit)"
        jupyter lab --log-level=40 --notebook-dir=./ ./scenarios/Reference.ipynb
    else
        msg "Launching Jupyter Lab... (Press Ctrl+C to exit)"
        jupyter lab --log-level=40 --notebook-dir=./
    fi
fi

# Deactivate
msg "Deactivating virtual environment..."
deactivate
success "Done"