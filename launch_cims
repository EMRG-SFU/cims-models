# Function to extract version number from Python executable
get_python_version() {
    local python_path=$1
    "$python_path" -c "import sys; print('{}.{}.{}'.format(*sys.version_info[:3]))" 2>/dev/null || echo "0.0.0"
}
        
# Function to compare two version strings (returns 0 if v1 >= v2)
version_gte() {
    local v1=$1
    local v2=$2
    printf '%s\n%s\n' "$v1" "$v2" | sort -V -C 2>/dev/null && return 0
    # Fallback for systems without sort -V
    local IFS=.
    local i ver1=($v1) ver2=($v2)
    for ((i=0; i<${#ver1[@]} || i<${#ver2[@]}; i++)); do
        if ((10#${ver1[i]:-0} > 10#${ver2[i]:-0})); then
            return 0
        elif ((10#${ver1[i]:-0} < 10#${ver2[i]:-0})); then
            return 1
        fi
    done
    return 0
}

